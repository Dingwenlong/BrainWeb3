# BrainWeb3 — PUBLIC DEMO environment.
# Copy to .env.production, replace every __CHANGE_ME__, then deploy.
#   cp .env.production.demo.example .env.production
# Generate secrets with:  openssl rand -hex 32
#
# NOTE: this is a DEMO profile — demo accounts + demo-password login are ON on purpose
# so visitors can sign in. Do NOT put real/sensitive data behind it.

# ---- Web / TLS ----
# Your domain (auto HTTPS). For a first IP-only smoke test, use:  SITE_ADDRESS=:80
SITE_ADDRESS=demo.example.com

# ---- MySQL (provisioned by the compose stack) ----
MYSQL_DATABASE=brainweb3
MYSQL_USER=brainweb3
MYSQL_PASSWORD=__CHANGE_ME_db_password__
MYSQL_ROOT_PASSWORD=__CHANGE_ME_root_password__

# ---- Backend datasource (password MUST match MYSQL_PASSWORD) ----
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/brainweb3?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=brainweb3
SPRING_DATASOURCE_PASSWORD=__CHANGE_ME_db_password__

# ---- Auth (demo login intentionally enabled) ----
AUTH_JWT_SECRET=__CHANGE_ME_run_openssl_rand_hex_32__
AUTH_TOKEN_TTL_HOURS=12
AUTH_REFRESH_TOKEN_TTL_DAYS=14
AUTH_DEMO_PASSWORD=brainweb3-demo
AUTH_ALLOW_DEMO_BOOTSTRAP=true
AUTH_ALLOW_DEMO_PASSWORD_LOGIN=true

# ---- Identity (DID / VC) ----
IDENTITY_ISSUER_DID=did:brainweb3:issuer:demo
IDENTITY_CREDENTIAL_SECRET=__CHANGE_ME_run_openssl_rand_hex_32__
IDENTITY_CREDENTIAL_TTL_DAYS=365

# ---- EEG service (in-compose) ----
EEG_SERVICE_BASE_URL=http://eeg-service:8101

# ---- Blockchain OFF for the demo (uses the mock gateway) ----
CHAIN_ENABLED=false

# ---- Storage on local disk (demo) ----
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=/opt/brainweb3/storage
